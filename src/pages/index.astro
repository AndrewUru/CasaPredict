---
import PredictForm from "../components/PredictForm.jsx";
---

<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Prediccion Precio Vivienda</title>
    <link rel="stylesheet" href="/styles.css" />
</head>
<body>
    <div class="landing-container">
        
        <header class="landing-header">
            <h1>Prediccion de Precio de Vivienda en Espana</h1>
            <p class="tagline">Estimaciones generadas con nuestro modelo de IA.</p>
        </header>

        <main>
            <section class="prediction-form-section">
                <h2>Calcula con IA el precio medio por comunidad</h2>
                <PredictForm client:only="react" />
            </section>

            <section class="benefits-section">
                <h2>Por que utilizar nuestra herramienta?</h2>
                <div class="benefits-grid">
                    <article class="benefit-item">
                        <h3>Informacion Precisa</h3>
                        <p>Estimaciones generadas por IA a partir de datos del mercado inmobiliario espanol.</p>
                    </article>
                    <article class="benefit-item">
                        <h3>Interfaz clara</h3>
                        <p>Selecciona una comunidad y obtendras un precio en segundos.</p>
                    </article>
                    <article class="benefit-item">
                        <h3>Motor IA</h3>
                        <p>Modelo entrenado con indicadores economicos que se actualizan de forma periodica.</p>
                    </article>
                    <article class="benefit-item">
                        <h3>Decisiones informadas</h3>
                        <p>Ideal para compradores, vendedores e inversores que quieren comparar regiones.</p>
                    </article>
                </div>
            </section>

            <section class="tech-stack-section">
                <h2>Tecnologia que impulsa esta herramienta</h2>
                <ul class="tech-list">
                    <li><strong>Frontend:</strong> Astro + React + CSS personalizado.</li>
                    <li><strong>Backend:</strong> FastAPI (Python) con un modelo de scikit-learn.</li>
                    <li><strong>Datos:</strong> CSV publicos de indicadores y precios de vivienda.</li>
                    <li><strong>Despliegue:</strong> Vite + Uvicorn.</li>
                    <li><strong>Preparado para:</strong> integracion con asistentes conversacionales.</li>
                </ul>
            </section>
        </main>

        <footer class="landing-footer">
            <p>&copy; 2025 Prediccion Precio Vivienda Espana</p>
            <nav class="footer-nav">
                <ul>
                    <li><a href="#">Terminos y Condiciones</a></li>
                    <li><a href="#">Politica de Privacidad</a></li>
                    <li><a href="#">Contacto</a></li>
                </ul>
            </nav>
        </footer>

        <div class="chat-bubble" onclick="alert('Proximamente chat IA de voz')">
            IA
        </div>
    </div>
</body>
</html>
